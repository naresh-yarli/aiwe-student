# ============================================================================
# AI Workflow Engineering — Environment Variables (TEMPLATE)
# Copy to `.env` and fill in. NEVER commit `.env`.
# In n8n these are surfaced as $env.VAR_NAME (self-hosted) or Credentials.
# ============================================================================

# ----- OpenRouter (Part I) --------------------------------------------------
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers (recommended by OpenRouter)
OPENROUTER_APP_URL=https://your-app.example.com
OPENROUTER_APP_TITLE=AI Workflow Engineering Course
# Default models (override per-workflow as needed)
LLM_DEFAULT_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODEL=anthropic/claude-3.5-haiku
EMBEDDING_MODEL=openai/text-embedding-3-small

# ----- n8n (self-hosted) ----------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Basic auth for the local n8n UI (dev only)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
GENERIC_TIMEZONE=UTC

# ----- Postgres (n8n persistence + app data) --------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# ----- Vector DB (Qdrant, Part I) -------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=course_knowledge

# ----- AWS (Part II) --------------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=ai-course
# Bedrock model IDs (must be enabled in your region/account)
BEDROCK_TEXT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_HAIKU_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Resource names (created by IaC in Part II)
DDB_TABLE_CONVERSATIONS=aiwe-conversations
DDB_TABLE_IDEMPOTENCY=aiwe-idempotency
S3_BUCKET_DOCS=aiwe-knowledge-docs
OPENSEARCH_COLLECTION=aiwe-rag
SECRETS_PREFIX=/aiwe/prod

# ----- Observability --------------------------------------------------------
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
